# Local single-binary development; production uses .env.prod.example.
MONITORING_MODE=test
CONTROL_LISTEN=127.0.0.1:13000
CONTROL_DATA_DIR=.local/data
CONTROL_ALLOWED_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
SSH_INVENTORY_FILE=.local/ssh/hosts.json
# Optional AI work hub. Paths belong to the machine running Pulse Ops.
# Configure the Jev API key and routing profiles in the authenticated Settings UI.
# PULSE_AI_PROJECT_ROOT=/home/your-user/projects
# PULSE_CODEX_BIN=/absolute/path/to/codex
# PULSE_CLAUDE_BIN=/absolute/path/to/claude
