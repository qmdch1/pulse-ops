MONITORING_MODE=production
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=
DASHBOARD_PORT=13000
DASHBOARD_ORIGIN=https://monitor.example.invalid
# Generate independent random values. Never commit the populated .env.prod.
# Master key: base64 encoded 32 random bytes. Retain the existing key on upgrades.
CONTROL_MASTER_KEY=
# Only used with compose.release.yml (published GHCR image). Pin a release, e.g. 3.0.0.
PULSE_OPS_VERSION=latest
